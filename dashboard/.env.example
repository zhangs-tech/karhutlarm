# Copy to .env and uncomment what you want to change.
# Defaults are in src/dashboard/config.py.

# Must match src/main.cpp
# DASHBOARD_MQTT_BROKER=broker.hivemq.com
# DASHBOARD_MQTT_PORT=1883
# DASHBOARD_MQTT_TOPIC=bingus-sic-6767420/sensors

# Must match get_status() in src/main.cpp
# DASHBOARD_GAS_THRESHOLD=3830
# DASHBOARD_TEMP_HIGH_THRESHOLD=50.0
# DASHBOARD_HUMIDITY_LOW_THRESHOLD=40.0

# Relative paths are resolved from the directory the server is started in.
# DASHBOARD_DB_PATH=karhutla.db
# DASHBOARD_WEB_DIR=web
